# Zabacode specific — runtime files must never appear in git status by default
# Project root runtime dirs (desktop fallback: APP_DIR = project root)
files/
cache/
logs/
user_packages/
user_files/

# Package-local runtime dirs (old fallback zabacode/ and Android double nesting files/files)
zabacode/files/
zabacode/cache/
zabacode/logs/
zabacode/user_packages/
zabacode/user_files/

# Active run script (runtime) — both locations
**/_active_run.py

# Generated images in runtime dirs only (not assets)
files/*.png
files/*.jpg
files/*.jpeg
zabacode/files/*.png
zabacode/files/*.jpg
zabacode/files/*.jpeg

